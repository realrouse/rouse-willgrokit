# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# GitHub account that owns/pushes to the public repo
GITHUB_USERNAME=realrouse

# Fine-grained or classic PAT with repo scope for this public repo only
# Create: GitHub → Settings → Developer settings → Personal access tokens
# Prefer fine-grained: contents read/write on rouse-willgrokit only
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public repo (no secrets, LBRY-safe research only)
GITHUB_OWNER=realrouse
GITHUB_REPO=rouse-willgrokit

# Remote URL (HTTPS). Scripts can inject the token for push; do not put the token in this file.
GITHUB_REMOTE=https://github.com/realrouse/rouse-willgrokit.git
